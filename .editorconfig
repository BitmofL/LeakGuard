root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
dotnet_sort_system_directives_first = true
csharp_prefer_keyword_using_directive = true:warning
indent_style = space
indent_size = 4
top_level_statements_enabled = true

[*.{xaml,xml}]
indent_size = 2
