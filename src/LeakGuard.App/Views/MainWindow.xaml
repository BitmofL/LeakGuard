<Window x:Class="LeakGuard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeakGuard.App"
        Title="LeakGuard — Сканер приватности"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        Background="{StaticResource BackgroundPrimary}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🛡" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LeakGuard" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                    <TextBlock Text="v0.1.0" FontSize="11" Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="?" x:Name="BtnHelp"
                            Width="32" Height="32"
                            FontSize="16" FontWeight="Bold"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Справка"
                            Click="BtnHelp_Click"/>
                    <Button Content="✕" x:Name="BtnClose"
                            Width="32" Height="32"
                            FontSize="14"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="4,0,0,0"
                            ToolTip="Закрыть"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource BackgroundPrimary}"/>

        <!-- Нижняя панель -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Готово к работе"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                           Text="Privacy by default · Локальная работа"
                           Foreground="{StaticResource TextTertiary}"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
