<UserControl x:Class="LeakGuard.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel>

            <!-- Заголовок -->
            <TextBlock Text="Результаты сканирования"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,20,0,8"/>

            <!-- Панель действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="📄 Экспорт отчёта"
                        Style="{StaticResource ScanButtonStyle}"
                        Padding="16,8"
                        Click="BtnExport_Click"
                        Margin="0,0,10,0"/>
                <Button Content="← Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Click="BtnBack_Click"/>
            </StackPanel>

            <!-- Фильтры -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Фильтры"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Уровень риска" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CmbRiskFilter" SelectedIndex="0" SelectionChanged="CmbRiskFilter_Changed">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Информация"/>
                                <ComboBoxItem Content="Низкий риск"/>
                                <ComboBoxItem Content="Средний риск"/>
                                <ComboBoxItem Content="Высокий риск"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Категория" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CmbCategoryFilter" SelectedIndex="0" SelectionChanged="CmbCategoryFilter_Changed">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Персональные данные"/>
                                <ComboBoxItem Content="Документы"/>
                                <ComboBoxItem Content="Архивы"/>
                                <ComboBoxItem Content="Метаданные изображений"/>
                                <ComboBoxItem Content="Чувствительные документы"/>
                                <ComboBoxItem Content="Файлы разработчика"/>
                                <ComboBoxItem Content="Резервные копии"/>
                                <ComboBoxItem Content="Автозапуск"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Поиск" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                     Text="Фильтр по пути или названию..."
                                     Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="Сбросить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8"
                                Margin="10,18,0,0"
                                Click="BtnResetFilters_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Результаты с панелью подробностей -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Список результатов -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Результаты"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       Text="{Binding ResultCount, ElementName=ResultsView}"
                                       Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </Grid>
                        <ListBox x:Name="ResultsList"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ResultListItemStyle}"
                                            Margin="0,0,0,6" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryDisplay}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1" Style="{StaticResource RiskIndicatorStyle}"
                                                    Padding="6,2" CornerRadius="10">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding RiskColor}"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding RiskLevelDisplay}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#1a1b26"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Правая панель подробностей -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                        Margin="16,0,0,0" VerticalAlignment="Top">
                    <Border x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Подробности"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryDisplay}"
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Риск:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <Border Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource RiskIndicatorStyle}"
                                        Background="{Binding RiskColor, Converter={StaticResource RiskToBrushConverter}}"
                                        Padding="8,2" CornerRadius="8" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding RiskLevelDisplay}" FontSize="11"
                                               FontWeight="Bold" Foreground="#1a1b26"/>
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Причина:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Reason}"
                                           Foreground="{StaticResource TextPrimary}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Расширение:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FileType}"
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Размер:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding FileSize, Converter={StaticResource BytesToHumanConverter}}"
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Рекомендация:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Recommendation}"
                                           Foreground="{StaticResource AccentGreenLight}" FontSize="11"
                                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <!-- Путь — скрыт по умолчанию -->
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <TextBlock Text="Путь к файлу:" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="TxbDetailPath" Text=""
                                               Foreground="{StaticResource TextTertiary}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,3,0,6"
                                               Visibility="Collapsed"/>
                                    <Button x:Name="BtnShowPath" Content="👁 Показать путь"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,3" FontSize="10"
                                            Click="BtnShowPath_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Замаскированный пример -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Замаскированный пример:" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    <TextBlock Text="{Binding MaskedExample}"
                                               Foreground="{StaticResource TextTertiary}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Кнопки действий -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnOpenLocation" Content="📂 Открыть"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" Margin="0,0,6,0"
                                        Click="BtnOpenLocation_Click"/>
                                <Button x:Name="BtnIgnore" Content="🚫 Игнорировать"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" Margin="0,0,6,0"
                                        Click="BtnIgnore_Click"/>
                                <Button x:Name="BtnCloseDetail" Content="✕ Закрыть"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="10,5"
                                        Click="BtnCloseDetail_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
