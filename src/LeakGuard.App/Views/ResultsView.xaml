<UserControl x:Class="LeakGuard.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel>

            <!-- Заголовок -->
            <TextBlock Text="Результаты сканирования"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,20,0,8"/>

            <!-- Панель действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="📄 Экспорт отчёта"
                        Style="{StaticResource ScanButtonStyle}"
                        Padding="16,8"
                        Click="BtnExport_Click"
                        Margin="0,0,10,0"/>
                <Button Content="← Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Click="BtnBack_Click"/>
            </StackPanel>

            <!-- Фильтры -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Фильтры"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Уровень риска" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CmbRiskFilter" SelectedIndex="0" SelectionChanged="CmbRiskFilter_Changed">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Информация"/>
                                <ComboBoxItem Content="Низкий риск"/>
                                <ComboBoxItem Content="Средний риск"/>
                                <ComboBoxItem Content="Высокий риск"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Категория" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CmbCategoryFilter" SelectedIndex="0" SelectionChanged="CmbCategoryFilter_Changed">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Персональные данные"/>
                                <ComboBoxItem Content="Документы"/>
                                <ComboBoxItem Content="Архивы"/>
                                <ComboBoxItem Content="Метаданные изображений"/>
                                <ComboBoxItem Content="Чувствительные документы"/>
                                <ComboBoxItem Content="Файлы разработчика"/>
                                <ComboBoxItem Content="Резервные копии"/>
                                <ComboBoxItem Content="Автозапуск"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Поиск" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                     Text="Фильтр по пути или названию..."
                                     Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="Сбросить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8"
                                Margin="10,18,0,0"
                                Click="BtnResetFilters_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Результаты -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Результаты"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                   Text="{Binding ResultCount, ElementName=ResultsView}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    </Grid>
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ResultListItemStyle}"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryDisplay}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1" Style="{StaticResource RiskIndicatorStyle}"
                                                    Padding="6,2" CornerRadius="10">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding RiskColor}"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding RiskLevelDisplay}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#1a1b26"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Reason}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FilePath}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Recommendation}" FontSize="11"
                                                   Foreground="{StaticResource AccentGreenLight}"
                                                   Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="📂 Открыть"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4" FontSize="11"
                                                    Click="BtnOpenLocation_Click"
                                                    Tag="{Binding FilePath}"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="👁 Игнорировать"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4" FontSize="11"
                                                    Click="BtnIgnore_Click"
                                                    Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
